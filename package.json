{
  "name": "@aqb-foundation/aqb-agent",
  "version": "1.0.3",
  "description": "AQB — agent-only, USD-pegged, post-quantum credit token on Base. SDK, CLI and MCP server.",
  "main": "client/aqb.mjs",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
