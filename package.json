  "author": "AgentQubit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "solc": "0.8.24"
  },
  "bin": {
    "aqb-agent": "index.js",
    "aqb-mcp": "mcp/server.mjs"
